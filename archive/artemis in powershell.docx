**mock_data_generator.py**
```python
import random
import datetime
from typing import Dict, List

# Define mock ocean sensor data types
SensorData = Dict[str, float]
WildlifeSighting = Dict[str, str]

def generate_temperature_sensor_data(min_temp: float = 10.0, max_temp: float = 30.0) -> SensorData:
    return {"temperature": round(random.uniform(min_temp, max_temp), 2)}

def generate_salinity_sensor_data(min_salinity: float = 20.0, max_salinity: float = 40.0) -> SensorData:
    return {"salinity": round(random.uniform(min_salinity, max_salinity), 2)}

def generate_acoustic_ping_data() -> SensorData:
    ping_type = random.choice(["fish", "whale", "other"])
    return {"acoustic_ping": ping_type}

def generate_wildlife_sighting(
    species: List[str] = ["tuna", "swordfish", "dolphin"],
    location: List[str] = ["North Atlantic", "South Pacific", "Indian Ocean"],
) -> WildlifeSighting:
    return {
        "species": random.choice(species),
        "location": random.choice(location),
        "timestamp": datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%SZ"),
    }

def generate_mock_data(num_samples: int = 10) -> List[Dict[str, object]]:
    mock_data = []
    for _ in range(num_samples):
        temperature_data = generate_temperature_sensor_data()
        salinity_data = generate_salinity_sensor_data()
        acoustic_ping_data = generate_acoustic_ping_data()
        wildlife_sighting = generate_wildlife_sighting()

        sample_data = {
            "timestamp": datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%SZ"),
            "temperature": temperature_data,
            "salinity": salinity_data,
            "acoustic_ping": acoustic_ping_data,
            "wildlife_sighting": wildlife_sighting,
        }

        mock_data.append(sample_data)

    return mock_data

if __name__ == "__main__":
    num_samples = 20
    mock_data = generate_mock_data(num_samples)
    print(mock_data)
```
This script generates mock ocean sensor data (temperature, salinity, acoustic pings) and wildlife sightings. You can adjust
the number of samples to generate by modifying the `num_samples` variable.

The generated data is a list of dictionaries, where each dictionary represents a single sample with the following keys:

* `timestamp`: the timestamp of the sample
* `temperature`: a dictionary containing temperature sensor data
* `salinity`: a dictionary containing salinity sensor data
* `acoustic_ping`: a dictionary containing acoustic ping data
* `wildlife_sighting`: a dictionary containing wildlife sighting data

You can use this mock data to test your agents without relying on real hardware.

